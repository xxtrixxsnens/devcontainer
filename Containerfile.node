# Development Containerfile for Node / pnpm
# Built for Podman / Docker with rootless keep-id support

FROM node:20-alpine3.20

# Install build dependencies, git, bash, curl, and Neovim 0.12 from edge
RUN apk add --no-cache \
    build-base \
    curl \
    bash

# Pre-create the cloud user and group matching host UID/GID 1000
ENV PUID=1000
ENV PGID=1000

RUN (deluser node || true) && \
    (delgroup node || true) && \
    addgroup -g ${PGID} cloud && \
    adduser -u ${PUID} -G cloud -h /home/cloud -s /bin/bash -D cloud && \
    mkdir -p /home/cloud && \
    chown -R cloud:cloud /home/cloud

# Enable Corepack and prepare pnpm
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate

# Setup working directory inside the mounted volume
WORKDIR /workplace

# Configure pnpm to cache packages and store dependencies on the host
ENV PNPM_HOME=/workplace/.pnpm-home
ENV pnpm_config_store_dir=/workplace/.pnpm-store
ENV PATH=$PNPM_HOME:$PATH

# Switch to the non-root developer user
USER cloud

# Automatically install packages on startup and run the Vite dev server
CMD ["sh", "-c", "if [ -f package.json ]; then pnpm install; fi && pnpm dev"]

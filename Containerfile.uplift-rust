ARG RUST_BASE_IMAGE
ARG UPLIFT_BASE_IMAGE

FROM ${UPLIFT_BASE_IMAGE} AS uplift

FROM ${RUST_BASE_IMAGE}

USER root

COPY --from=uplift /usr/bin/uplift /usr/bin/uplift

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       git \
    && rm -rf /var/lib/apt/lists/*

USER runner

WORKDIR /workspace
CMD ["/bin/bash"]
